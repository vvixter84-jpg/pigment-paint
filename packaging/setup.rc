#include <windows.h>

101 ICON "..\\assets\\icon.ico"
1 24 "setup.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Pigment Studio"
            VALUE "FileDescription", "Pigment Paint Installer"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "PigmentSetup"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "PigmentSetup.exe"
            VALUE "ProductName", "Pigment Paint"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
